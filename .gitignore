# ========================================
# Project-Specific
# ========================================
# Keep the prebuilt JAR but ignore other JARs
*.jar
!WorkflowCoverageCalculator/AVCumulativeWorkflowCoverageCalculator-0.0.1-SNAPSHOT-jar-with-dependencies.jar

# Ignore output files but keep examples
WorkflowCoverageLog.txt
data*.json

# Ignore copied JSON files from test machines
WorkflowsCoverageRecords*.json
